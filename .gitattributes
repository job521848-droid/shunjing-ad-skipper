# 统一换行符，避免 Windows 克隆后脚本失效
* text=auto eol=lf

# Gradle Wrapper 必须是 LF + 可执行
gradlew        text eol=lf
gradlew.bat    text eol=crlf

# 源码
*.java         text eol=lf
*.xml          text eol=lf
*.gradle       text eol=lf
*.properties   text eol=lf
*.md           text eol=lf

# 二进制文件
*.jar          binary
*.png          binary
*.jpg          binary
*.webp         binary
*.ttf          binary
*.so           binary
*.apk          binary

# 语言统计：标记文档与资源，避免 GitHub 语言识别被干扰
docs/**        linguist-documentation
*.md           linguist-documentation
