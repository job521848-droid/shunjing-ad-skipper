# =====================================================================
# 瞬净 ShunJing —— Android 项目 .gitignore
# 目标：只提交源码、构建脚本与必要文档；编译产物、签名文件、本机配置一律不入库
# =====================================================================

# ---------------------------------------------------------------------
# 1. Android / Gradle 构建产物
# ---------------------------------------------------------------------
build/
app/build/
*/build/
**/build/
.gradle/
**/.gradle/
gradle-app.setting
local.properties
captures/
.externalNativeBuild/
.cxx/
release/
outputs/
*.hprof

# 编译中间件与产物（双保险，防止 build/ 被误移到别处）
*.apk
*.aab
*.ap_
*.aar
*.dex
*.class
*.idsig
*.split
*.obb
*.zip
*.mapping
lint-results*.html
lint-results*.xml

# 通用 jar，但必须保留 Gradle Wrapper 自身
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ---------------------------------------------------------------------
# 2. 签名与密钥（严禁入库）
# ---------------------------------------------------------------------
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
keystore.properties
signing.properties
secrets.properties
signingConfig.json

# ---------------------------------------------------------------------
# 3. 本机 / 环境配置
# ---------------------------------------------------------------------
gradle.properties.bak
.env
.env.*
*.local

# ---------------------------------------------------------------------
# 4. IDE / 编辑器
# ---------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath
.metadata/
nbproject/private/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.#*
\#*\#

# ---------------------------------------------------------------------
# 5. 系统垃圾文件
# ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------------------------------------------------------------------
# 6. 运行时日志 / 抓取快照 / 调试留样
# ---------------------------------------------------------------------
*.log
logs/
crash/
crashes/
dumps/
snapshots/
*.dump
*.dumpsys
*.trace
tmpdbg/

# ---------------------------------------------------------------------
# 7. 其它
# ---------------------------------------------------------------------
node_modules/
.pnpm-store/
*.tmp
*.bak
*.orig
*.rej
